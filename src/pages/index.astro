---
// Laporun - High Accuracy GPS Engine + WakeLock + Responsive Pace
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>Laporun - High Accuracy Tracker</title>

    <script src="https://cdn.tailwindcss.com" is:inline></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline></script>

    <style is:global>
      html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        overscroll-behavior: none;
      }
      #map {
        height: 100%;
        width: 100%;
        z-index: 1;
      }
      .leaflet-control-attribution {
        display: none !important;
      }
      .km-badge {
        background-color: #0f172a;
        color: #f97316;
        border: 2px solid #f97316;
        border-radius: 9999px;
        font-size: 10px;
        font-weight: 900;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.4);
      }
    </style>
  </head>
  <body class="bg-slate-900 text-slate-100 font-sans h-[100dvh] w-full flex flex-col justify-between select-none overflow-hidden">
    
    <!-- 1. Header -->
    <header class="px-4 py-3 flex justify-between items-center bg-slate-800/90 backdrop-blur border-b border-slate-700/60 z-10 shrink-0">
      <div>
        <h1 class="text-lg font-black italic tracking-tight text-orange-500 uppercase leading-none">Laporun</h1>
        <p class="text-[8px] font-bold text-slate-400 tracking-widest uppercase mt-0.5" id="gps-accuracy-info">GPS Precision: Idle</p>
      </div>
      <div id="gps-status" class="flex items-center gap-1.5 bg-slate-700/50 px-2.5 py-1 rounded-full border border-slate-600">
        <span id="gps-dot" class="w-2 h-2 rounded-full bg-slate-400"></span>
        <span id="gps-text" class="text-[8px] font-black tracking-wider uppercase text-slate-300">Standby</span>
      </div>
    </header>

    <!-- 2. Area Map -->
    <div class="relative flex-1 min-h-0 w-full bg-slate-950 overflow-hidden">
      <div id="map"></div>

      <!-- Tombol Re-center -->
      <button
        id="btn-recenter"
        type="button"
        class="absolute bottom-3 right-3 z-[400] bg-slate-900/90 hover:bg-slate-800 active:scale-90 text-orange-500 p-2.5 rounded-xl shadow-lg border border-slate-700/80 transition-all cursor-pointer flex items-center justify-center"
        title="Pusatkan ke lokasi saya"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="12" cy="12" r="3" stroke-width="2.5"></circle>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v3m0 14v3M2 12h3m14 0h3"></path>
        </svg>
      </button>
    </div>

    <!-- 3. Bottom HUD -->
    <div class="bg-slate-800 border-t border-slate-700/60 p-4 rounded-t-2xl shadow-2xl space-y-3 z-10 shrink-0">
      <div class="grid grid-cols-3 gap-1 text-center divide-x divide-slate-700/50">
        <div>
          <p class="text-[8px] font-bold uppercase text-slate-400">Jarak</p>
          <p class="text-2xl font-black tracking-tight text-white leading-none mt-1"><span id="metric-dist">0.00</span></p>
          <p class="text-[8px] font-bold uppercase text-orange-400 mt-0.5">KM</p>
        </div>
        <div>
          <p class="text-[8px] font-bold uppercase text-slate-400">Durasi</p>
          <p class="text-2xl font-black tracking-tight text-white leading-none mt-1" id="metric-time">00:00</p>
          <p class="text-[8px] font-bold uppercase text-orange-400 mt-0.5">Waktu</p>
        </div>
        <div>
          <p class="text-[8px] font-bold uppercase text-slate-400">Pace</p>
          <p class="text-2xl font-black tracking-tight text-white leading-none mt-1" id="metric-pace">--'--"</p>
          <p class="text-[8px] font-bold uppercase text-orange-400 mt-0.5">/KM</p>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex gap-2">
        <button
          id="btn-run"
          class="flex-1 py-3 bg-orange-600 active:scale-[0.98] text-white font-black text-xs uppercase tracking-widest rounded-xl shadow-md shadow-orange-600/30 transition-all cursor-pointer"
        >
          Start Run
        </button>
        <button
          id="btn-finish"
          class="hidden px-5 py-3 bg-green-600 active:scale-[0.98] text-white font-black text-xs uppercase tracking-widest rounded-xl transition-all cursor-pointer"
        >
          Finish
        </button>
        <button
          id="btn-reset"
          class="px-5 py-3 bg-slate-700 active:scale-[0.98] text-slate-300 font-black text-xs uppercase tracking-widest rounded-xl transition-all cursor-pointer"
        >
          Reset
        </button>
      </div>
    </div>

    <!-- Modal Recap Activity -->
    <div id="modal-summary" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-[1000] p-4 flex items-end sm:items-center justify-center overflow-y-auto">
      <div class="bg-slate-900 border border-slate-700/80 w-full max-w-md rounded-2xl p-5 shadow-2xl space-y-4 max-h-[85vh] flex flex-col">
        <div class="flex justify-between items-center border-b border-slate-800 pb-3 shrink-0">
          <div>
            <h2 class="text-xl font-black italic tracking-tight text-orange-500 uppercase">Activity Recap</h2>
            <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest" id="recap-timestamp">Run Finished</p>
          </div>
          <button id="btn-close-modal" class="p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-400 rounded-full cursor-pointer">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
            </svg>
          </button>
        </div>

        <div class="space-y-4 overflow-y-auto pr-1">
          <div class="grid grid-cols-2 gap-2">
            <div class="bg-slate-800/60 p-3 rounded-xl border border-slate-700/40 text-center">
              <p class="text-[9px] font-bold uppercase text-slate-400">Total Jarak</p>
              <p class="text-2xl font-black text-white mt-0.5"><span id="summary-dist">0.00</span> <span class="text-xs text-orange-400">KM</span></p>
            </div>
            <div class="bg-slate-800/60 p-3 rounded-xl border border-slate-700/40 text-center">
              <p class="text-[9px] font-bold uppercase text-slate-400">Total Waktu</p>
              <p class="text-2xl font-black text-white mt-0.5" id="summary-time">00:00</p>
            </div>
            <div class="bg-slate-800/60 p-3 rounded-xl border border-slate-700/40 text-center">
              <p class="text-[9px] font-bold uppercase text-slate-400">Avg Pace</p>
              <p class="text-xl font-black text-white mt-0.5" id="summary-avg-pace">--'--"</p>
            </div>
            <div class="bg-slate-800/60 p-3 rounded-xl border border-slate-700/40 text-center">
              <p class="text-[9px] font-bold uppercase text-slate-400">Best Split</p>
              <p class="text-xl font-black text-green-400 mt-0.5" id="summary-best-split">--'--"</p>
            </div>
          </div>

          <div class="space-y-2">
            <h3 class="text-[10px] font-black uppercase tracking-widest text-slate-300">Kilometer Splits</h3>
            <div id="splits-container" class="space-y-1.5"></div>
          </div>
        </div>

        <div class="pt-2 border-t border-slate-800 shrink-0">
          <button
            id="btn-recap-done"
            class="w-full py-3 bg-orange-600 hover:bg-orange-500 active:scale-[0.98] text-white font-black text-xs uppercase tracking-widest rounded-xl transition-all cursor-pointer"
          >
            Kembali ke Peta
          </button>
        </div>
      </div>
    </div>

    <!-- Script Engine -->
    <script is:inline>
      let map, pathLine, currentMarker, startMarker, endMarker;
      let splitMarkers = [];
      let isTracking = false;
      let watchId = null;
      let timer = null;
      let wakeLock = null;

      let totalKm = 0;
      let seconds = 0;
      let routeCoords = [];
      let latestLatLng = null;

      // Split data
      let splits = [];
      let lastSplitSec = 0;
      let nextTargetKm = 1;

      // Rolling window untuk perhitungan pace instan yang responsif
      let recentPositions = [];

      function initMap() {
        map = L.map('map', { zoomControl: false }).setView([-6.2088, 106.8456], 16);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19
        }).addTo(map);

        pathLine = L.polyline([], {
          color: '#f97316',
          weight: 5,
          opacity: 0.9,
          lineJoin: 'round'
        }).addTo(map);

        setTimeout(() => {
          map.invalidateSize();
        }, 200);

        if (navigator.geolocation) {
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              latestLatLng = [pos.coords.latitude, pos.coords.longitude];
              map.setView(latestLatLng, 16);
              updateCurrentMarker(latestLatLng);
              updateAccuracyInfo(pos.coords.accuracy);
            },
            (err) => console.warn('Gagal inisialisasi GPS:', err.message),
            { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
          );
        }
      }

      function updateAccuracyInfo(acc) {
        const info = document.getElementById('gps-accuracy-info');
        if (info && acc !== undefined) {
          info.innerText = `GPS: ±${Math.round(acc)}m accuracy`;
        }
      }

      function updateCurrentMarker(latLng) {
        if (!currentMarker) {
          currentMarker = L.circleMarker(latLng, {
            radius: 7,
            fillColor: '#f97316',
            color: '#ffffff',
            weight: 2.5,
            fillOpacity: 1
          }).addTo(map);
        } else {
          currentMarker.setLatLng(latLng);
        }
      }

      function getDistanceKm(lat1, lon1, lat2, lon2) {
        const R = 6371;
        const dLat = ((lat2 - lat1) * Math.PI) / 180;
        const dLon = ((lon2 - lon1) * Math.PI) / 180;
        const a =
          Math.sin(dLat / 2) * Math.sin(dLat / 2) +
          Math.cos((lat1 * Math.PI) / 180) * Math.cos((lat2 * Math.PI) / 180) *
          Math.sin(dLon / 2) * Math.sin(dLon / 2);
        return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
      }

      function formatTime(s) {
        const m = Math.floor(s / 60);
        const remSec = Math.floor(s % 60);
        return `${m.toString().padStart(2, '0')}:${remSec.toString().padStart(2, '0')}`;
      }

      function formatPace(paceSecPerKm) {
        if (!paceSecPerKm || !isFinite(paceSecPerKm) || paceSecPerKm <= 0 || paceSecPerKm > 1800) {
          return `--'--"`;
        }
        const pMins = Math.floor(paceSecPerKm / 60);
        const pSecs = Math.round(paceSecPerKm % 60);
        return `${pMins}'${pSecs.toString().padStart(2, '0')}"`;
      }

      // Hitung Pace yang responsif
      function calculateLivePace(pos) {
        // 1. Coba baca hardware speed (meter/detik)
        if (pos.coords.speed !== null && pos.coords.speed !== undefined && pos.coords.speed > 0.8) {
          const paceSecPerKm = 1000 / pos.coords.speed;
          return formatPace(paceSecPerKm);
        }

        // 2. Rolling window 15 detik terakhir
        const now = Date.now();
        recentPositions.push({ lat: pos.coords.latitude, lng: pos.coords.longitude, time: now });
        // Simpan titik dalam 15 detik terakhir saja
        recentPositions = recentPositions.filter(p => now - p.time <= 15000);

        if (recentPositions.length >= 2) {
          const oldest = recentPositions[0];
          const windowDist = getDistanceKm(oldest.lat, oldest.lng, pos.coords.latitude, pos.coords.longitude);
          const windowTimeSec = (now - oldest.time) / 1000;

          if (windowDist > 0.005 && windowTimeSec > 3) {
            const rollingPace = windowTimeSec / windowDist;
            return formatPace(rollingPace);
          }
        }

        // 3. Fallback ke rata-rata total jika baru mulai lari
        if (totalKm > 0.03 && seconds > 0) {
          return formatPace(seconds / totalKm);
        }

        return `--'--"`;
      }

      function onPositionUpdate(pos) {
        const { latitude: lat, longitude: lng, accuracy } = pos.coords;
        updateAccuracyInfo(accuracy);

        // Abaikan titik jika sinyal GPS sangat buruk (> 30 meter)
        if (accuracy > 30) return;

        latestLatLng = [lat, lng];

        if (routeCoords.length === 0) {
          startMarker = L.circleMarker(latestLatLng, {
            radius: 7,
            fillColor: '#22c55e',
            color: '#ffffff',
            weight: 2.5,
            fillOpacity: 1
          }).addTo(map).bindPopup('Start').openPopup();

          routeCoords.push(latestLatLng);
          updateCurrentMarker(latestLatLng);
          return;
        }

        const prev = routeCoords[routeCoords.length - 1];
        const stepDist = getDistanceKm(prev[0], prev[1], lat, lng);

        // Hanya tambahkan jika perpindahan realistis (> 2 meter dan < 50 meter per update)
        if (stepDist > 0.002 && stepDist < 0.05) {
          totalKm += stepDist;
          document.getElementById('metric-dist').innerText = totalKm.toFixed(2);

          routeCoords.push(latestLatLng);
          pathLine.setLatLngs(routeCoords);
          updateCurrentMarker(latestLatLng);

          // LOGIKA SPLIT KM AKUMULASI
          if (totalKm >= nextTargetKm) {
            const splitDuration = seconds - lastSplitSec;
            splits.push({
              km: nextTargetKm,
              duration: splitDuration,
              pace: formatPace(splitDuration),
              cumulativeSeconds: seconds
            });

            // Tancap badge KM di peta
            const kmIcon = L.divIcon({
              className: 'km-badge',
              html: `${nextTargetKm}`,
              iconSize: [20, 20]
            });
            const splitMarker = L.marker(latestLatLng, { icon: kmIcon }).addTo(map);
            splitMarkers.push(splitMarker);

            lastSplitSec = seconds;
            nextTargetKm++;
          }
        }

        // Update display pace secara real-time
        const livePace = calculateLivePace(pos);
        document.getElementById('metric-pace').innerText = livePace;
        map.panTo(latestLatLng);
      }

      // Mencegah HP mati/lock saat lari (Screen Wake Lock API)
      async function requestWakeLock() {
        try {
          if ('wakeLock' in navigator) {
            wakeLock = await navigator.wakeLock.request('screen');
          }
        } catch (err) {
          console.warn('Wake Lock error:', err.message);
        }
      }

      function releaseWakeLock() {
        if (wakeLock) {
          wakeLock.release().then(() => {
            wakeLock = null;
          });
        }
      }

      function recenterMap() {
        if (latestLatLng) {
          map.flyTo(latestLatLng, 17, { animate: true, duration: 0.8 });
        }
      }

      function startRun() {
        if (!navigator.geolocation) {
          alert('GPS tidak didukung di browser ini.');
          return;
        }

        isTracking = true;
        requestWakeLock();

        document.getElementById('btn-run').innerText = 'Pause';
        document.getElementById('btn-run').className = 'flex-1 py-3 bg-slate-700 active:scale-[0.98] text-white font-black text-xs uppercase tracking-widest rounded-xl transition-all cursor-pointer';
        document.getElementById('btn-finish').classList.remove('hidden');

        document.getElementById('gps-dot').className = 'w-2 h-2 rounded-full bg-green-500 animate-ping';
        document.getElementById('gps-text').innerText = 'GPS Live';
        document.getElementById('gps-text').className = 'text-[8px] font-black tracking-wider uppercase text-green-400';

        // Timer independen
        timer = setInterval(() => {
          seconds++;
          document.getElementById('metric-time').innerText = formatTime(seconds);
        }, 1000);

        watchId = navigator.geolocation.watchPosition(
          onPositionUpdate,
          (err) => console.warn('GPS Signal error:', err.message),
          {
            enableHighAccuracy: true,
            maximumAge: 0,
            timeout: 5000
          }
        );
      }

      function pauseRun() {
        isTracking = false;
        releaseWakeLock();

        document.getElementById('btn-run').innerText = 'Resume';
        document.getElementById('btn-run').className = 'flex-1 py-3 bg-orange-600 active:scale-[0.98] text-white font-black text-xs uppercase tracking-widest rounded-xl shadow-md shadow-orange-600/30 transition-all cursor-pointer';

        document.getElementById('gps-dot').className = 'w-2 h-2 rounded-full bg-amber-400';
        document.getElementById('gps-text').innerText = 'Paused';
        document.getElementById('gps-text').className = 'text-[8px] font-black tracking-wider uppercase text-amber-400';

        clearInterval(timer);
        if (watchId !== null) {
          navigator.geolocation.clearWatch(watchId);
          watchId = null;
        }
      }

      function showSummaryModal() {
        const currentSplits = [...splits];
        const remainingKm = totalKm - (nextTargetKm - 1);
        if (remainingKm > 0.05) {
          const remDuration = seconds - lastSplitSec;
          const remPaceSec = remDuration / remainingKm;
          currentSplits.push({
            km: `${(nextTargetKm - 1 + remainingKm).toFixed(2)}`,
            duration: remDuration,
            pace: formatPace(remPaceSec),
            cumulativeSeconds: seconds
          });
        }

        document.getElementById('summary-dist').innerText = totalKm.toFixed(2);
        document.getElementById('summary-time').innerText = formatTime(seconds);
        
        const avgPaceSec = totalKm > 0.05 ? seconds / totalKm : 0;
        document.getElementById('summary-avg-pace').innerText = formatPace(avgPaceSec);

        if (splits.length > 0) {
          const fastest = [...splits].sort((a, b) => a.duration - b.duration)[0];
          document.getElementById('summary-best-split').innerText = fastest.pace;
        } else {
          document.getElementById('summary-best-split').innerText = "--'--\"";
        }

        document.getElementById('recap-timestamp').innerText = new Date().toLocaleString('id-ID', {
          dateStyle: 'medium',
          timeStyle: 'short'
        });

        const container = document.getElementById('splits-container');
        if (currentSplits.length === 0) {
          container.innerHTML = `<p class="text-xs text-slate-500 italic text-center py-3">Belum ada split KM yang tercatat.</p>`;
        } else {
          const maxDuration = Math.max(...currentSplits.map((s) => s.duration));
          container.innerHTML = currentSplits.map((s) => {
            const barWidth = Math.max(15, (s.duration / maxDuration) * 100);
            return `
              <div class="bg-slate-800/80 p-2.5 rounded-lg flex items-center justify-between gap-2.5 text-xs">
                <span class="font-black text-slate-300 w-12">KM ${s.km}</span>
                <div class="flex-1 bg-slate-900 rounded-full h-1.5 overflow-hidden">
                  <div class="bg-orange-500 h-full rounded-full" style="width: ${barWidth}%"></div>
                </div>
                <div class="text-right w-24">
                  <span class="font-mono font-bold text-white text-[11px]">${s.pace}</span>
                  <span class="text-[8px] text-slate-400 block">${formatTime(s.duration)} (Tot: ${formatTime(s.cumulativeSeconds)})</span>
                </div>
              </div>
            `;
          }).join('');
        }

        document.getElementById('modal-summary').classList.remove('hidden');
      }

      function finishRun() {
        pauseRun();
        document.getElementById('btn-finish').classList.add('hidden');
        document.getElementById('btn-run').innerText = 'Done';
        document.getElementById('btn-run').classList.add('pointer-events-none', 'opacity-50');

        if (routeCoords.length > 0) {
          const lastCoord = routeCoords[routeCoords.length - 1];
          endMarker = L.circleMarker(lastCoord, {
            radius: 7,
            fillColor: '#ef4444',
            color: '#ffffff',
            weight: 2.5,
            fillOpacity: 1
          }).addTo(map).bindPopup('Finish').openPopup();

          map.fitBounds(pathLine.getBounds(), { padding: [30, 30] });
        }

        showSummaryModal();
      }

      function resetRun() {
        pauseRun();
        seconds = 0;
        totalKm = 0;
        routeCoords = [];
        splits = [];
        lastSplitSec = 0;
        nextTargetKm = 1;
        recentPositions = [];

        document.getElementById('metric-dist').innerText = '0.00';
        document.getElementById('metric-time').innerText = '00:00';
        document.getElementById('metric-pace').innerText = `--'--"`;

        const runBtn = document.getElementById('btn-run');
        runBtn.innerText = 'Start Run';
        runBtn.className = 'flex-1 py-3 bg-orange-600 active:scale-[0.98] text-white font-black text-xs uppercase tracking-widest rounded-xl shadow-md shadow-orange-600/30 transition-all cursor-pointer';
        runBtn.classList.remove('pointer-events-none', 'opacity-50');
        
        document.getElementById('btn-finish').classList.add('hidden');

        document.getElementById('gps-dot').className = 'w-2 h-2 rounded-full bg-slate-400';
        document.getElementById('gps-text').innerText = 'Standby';
        document.getElementById('gps-text').className = 'text-[8px] font-black tracking-wider uppercase text-slate-300';

        pathLine.setLatLngs([]);
        if (startMarker) { map.removeLayer(startMarker); startMarker = null; }
        if (endMarker) { map.removeLayer(endMarker); endMarker = null; }

        splitMarkers.forEach((m) => map.removeLayer(m));
        splitMarkers = [];

        recenterMap();
      }

      window.addEventListener('DOMContentLoaded', () => {
        initMap();

        window.addEventListener('resize', () => {
          if (map) map.invalidateSize();
        });

        document.getElementById('btn-recenter').addEventListener('click', recenterMap);

        document.getElementById('btn-run').addEventListener('click', () => {
          if (isTracking) pauseRun();
          else startRun();
        });

        document.getElementById('btn-finish').addEventListener('click', finishRun);
        document.getElementById('btn-reset').addEventListener('click', resetRun);

        const closeModal = () => document.getElementById('modal-summary').classList.add('hidden');
        document.getElementById('btn-close-modal').addEventListener('click', closeModal);
        document.getElementById('btn-recap-done').addEventListener('click', closeModal);
      });
    </script>
  </body>
</html>